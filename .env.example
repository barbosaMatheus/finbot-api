# finbot-api environment
#
# Only needed when you run the API directly on your machine:
#
#   cp .env.example .env && npm install && npm run dev
#
# Under Docker Compose this file is NOT used — the stack is configured from the
# repo root (`finbot-app/.env`, see ../DOCKER.md). Keep the two in sync when you
# add a variable: this file is the source of truth for what the API reads.
#
# Never commit a real .env. Placeholders only.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origin allowed to send credentialed requests (the Expo web client).
CORS_ORIGIN=http://localhost:8081

# --- Database ---------------------------------------------------------------
# Running locally, Postgres is on localhost. Inside Compose the host is `db`.
DATABASE_URL=postgres://finbot:finbot@localhost:5432/finbot
# Must match the VECTOR(n) column width in src/db/migrations/001-create-schema.sql.
PG_VECTOR_SIZE=768

# --- Auth (required) --------------------------------------------------------
# The API throws if these are unset: /auth/register and /auth/login will 500.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set COOKIE_SECURE=true (and SameSite=none) only when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Plaid ------------------------------------------------------------------
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# sandbox | production
PLAID_ENV=sandbox
# Comma-separated. See https://plaid.com/docs/api/products/
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Encrypts Plaid access tokens at rest (AES-256-GCM, src/lib/crypto.ts).
# REQUIRED. Generate your own with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENC_KEY=change-me-generate-a-32-byte-base64-key==
# Optional. Only needed for OAuth institutions in the native app; must be
# registered in the Plaid Dashboard first. Sandbox works without them.
# PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
# PLAID_ANDROID_PACKAGE_NAME=com.finbotpbd.finbot
# Where Hosted Link returns the browser after the web flow finishes.
# Defaults to CORS_ORIGIN when unset.
# PLAID_HOSTED_LINK_REDIRECT_URI=http://localhost:8081
# Public URL Plaid delivers webhooks to (POST /plaid/webhook). Registered with
# Plaid per Item at link time, and re-registered for existing Items at worker
# boot. REQUIRED outside local development: without it Plaid sends no
# SYNC_UPDATES_AVAILABLE / ITEM events and transactions stop updating after
# the initial import. Localhost is not reachable from Plaid — use a tunnel.
# PLAID_WEBHOOK_URL=https://your-domain.example/plaid/webhook

# --- Model (gameplan narration) ---------------------------------------------
# The model only writes words around numbers the engine computed, and every
# number in its words is checked against its input; anything else falls back
# to a plain template. With LLM_PROVIDER unset the templates speak, so the
# stack works with no model host at all.
#   template  — no model call (default)
#   ollama    — local, OLLAMA_URL + OLLAMA_MODEL (a tiny model will mostly
#               fail the number check and fall back; llama3.1 or better works)
#   anthropic — hosted, ANTHROPIC_API_KEY + ANTHROPIC_MODEL
LLM_PROVIDER=template
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# ANTHROPIC_API_KEY=sk-ant-change-me
# ANTHROPIC_MODEL=claude-opus-5
# Thinking depth for narration: low (default) | medium | high.
# ANTHROPIC_EFFORT=low
# Per-call timeout for either host.
# LLM_TIMEOUT_MS=20000

# --- Local seed data --------------------------------------------------------
SEED_TEST_DATA=true
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=1234qwer
TEST_USER_ONBOARDING_COMPLETE=false
